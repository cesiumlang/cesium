{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.csm": "cesium",
      "*.csi": "cesium",
      "VERSION": "plaintext",
      ".local-gitignore": "gitignore",
      ".github/workflows/exempt.txt": "gitignore",
      ".clangd": "yaml",
      "**/.claude/projects/*/memory/*.md": "plaintext",
    },
    "files.exclude": {
      "**/node_modules/**": true,
      "**/.zig-cache/**": true,
      "**/zig-pkg/**": true,
      "**/zig-cache*/**": true,
      ".cache/**": true,
      ".devkit-downloads/**": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.zig-cache/**": true,
      "**/zig-pkg/**": true,
      "**/zig-cache*/**": true,
      "**/.cache/**": true,
      "**/.git/**": true,
      "zig-out/**": true,
      "tmp/**": true,
      ".devkit/**": true,
      ".devkit-downloads/**": true,
      "buildtools/bin/**": true,
      "buildtools/downloads/**": true,
      "buildtools/opt/**": true,
    },
    "search.exclude": {
      ".devkit/**": true,
      "buildtools/opt/**": true,
    },
    "files.insertFinalNewline": true,
    "editor.wrappingIndent": "indent",
    "[markdown]": {
      "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
      }
    },
    "editor.semanticTokenColorCustomizations": {
      "rules": {
        "*.deprecated": {
          // highlight semantic tokens that are marked as "deprecated"
          "strikethrough": true
        },
      },
    },
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\windows\\system32\\cmd.exe",
    },
    "ltex.additionalRules.motherTongue": "en-US",
    "debug.onTaskErrors": "abort",  // will switch to problems pane otherwise

    // the Zig of the Cesium devkit: python tools/fetch-devkit.py
    "zig.path": "${workspaceFolder}/.devkit/zig/zig",
    "zig.zls.enabled": "on",
    "zig.zls.inlayHintsShowParameterName": false,
    "zig.zls.inlayHintsExcludeSingleArgument": false,
    "zig.zls.inlayHintsShowBuiltin": false,
    "zig.zls.inlayHintsShowStructLiteralFieldType": false,
    "zig.zls.inlayHintsShowVariableTypeHints": false,
    "zig.zls.warnStyle": true,
    "zig.zls.enableArgumentPlaceholders": false,

    // The C of bootstrap/ is compiled by `zig cc`, which is Clang, so clangd
    // is the language server for it (.clangd, bootstrap/compile_flags.txt).
    // The devkit has no clangd: the clangd extension offers to download one
    // when none is on PATH. The Microsoft C/C++ extension stays for
    // debugging only.
    "C_Cpp.intelliSenseEngine": "disabled",

    // no CMake project here; C dependencies may carry a CMakeLists.txt
    "cmake.ignoreCMakeListsMissing": true,
    "cmake.configureOnOpen": false,
  },
  "extensions": {
    "recommendations": [
      "ziglang.vscode-zig",
      "llvm-vs-code-extensions.vscode-clangd",
      "ms-vscode.cpptools",  // windows debug
      // "vadimcn.vscode-lldb",  // posix debug
      "yzhang.markdown-all-in-one",
      "bierner.markdown-yaml-preamble",
      "streetsidesoftware.code-spell-checker",
      "streetsidesoftware.code-spell-checker-scientific-terms",
      "streetsidesoftware.code-spell-checker-win32",
      "ltex-plus.vscode-ltex-plus",
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "zig build",
        "type": "shell",
        "command": "${config:zig.path}",
        "args": [
          "build",
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "shared",
          "focus": true,
          "revealProblems": "never",
        },
      },
      {
        "label": "zig build test",
        "type": "shell",
        "command": "${config:zig.path}",
        "args": [
          "build",
          "test",
          "--summary",
          "all",
        ],
        "group": "test",
        "problemMatcher": [],
        "presentation": {
          "clear": true,
          "reveal": "always",
          "panel": "shared",
          "focus": true,
          "revealProblems": "never",
        },
      },
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "cesium0 (cppvsdbg)",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder}/zig-out/bin/cesium0.exe",
        "args": [
          "--emit-mir",
          "-o",
          "${workspaceFolder}/tmp/out.mir",
          "${workspaceFolder}/bootstrap/tests/s0/tokens.csm",
        ],
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "zig build",
        "console": "integratedTerminal",
      },
    ],
    "compounds": []
  },
}
