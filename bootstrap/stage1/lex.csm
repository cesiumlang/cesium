// cesium1: the lexer. Written in S0.
//
// It reads the token set of S0, which every later language level contains.
// Tokens for S1's additions are added when S1 is designed
// (cesiumlang/cesium#9, "Stage 1 goals").

// token kinds
const i32 TK_EOF = 0;
const i32 TK_ERROR = 1;
const i32 TK_IDENT = 2;
const i32 TK_INT = 3;
const i32 TK_CHAR = 4;
const i32 TK_STRING = 5;
const i32 TK_KEYWORD = 6;
const i32 TK_PUNCT = 7;

struct Token {
  i32 kind;
  uword start;  // offset of the first byte in the source
  uword len;
  u64 line;
  u64 col;
  u64 value;    // TK_INT and TK_CHAR
}

struct Lexer {
  #u8 src;
  uword len;
  uword pos;
  u64 line;
  u64 col;
}

void = lex_init(~Lexer lx, #u8 src, uword len) {
  lx.src #= src;
  lx.len = len;
  lx.pos = 0;
  lx.line = 1;
  lx.col = 1;
}

u8 = is_digit(u8 c) {
  return c >= '0' && c <= '9';
}

u8 = is_ident_start(u8 c) {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

u8 = is_ident_char(u8 c) {
  return is_ident_start(c) || is_digit(c);
}

// The byte at pos + ahead, or 0 past the end.
u8 = peek(#Lexer lx, uword ahead) {
  uword at = lx.pos + ahead;
  if (at < lx.len) {
    return lx.src[at];
  }
  return 0;
}

void = advance(~Lexer lx) {
  if (lx.pos < lx.len) {
    if (lx.src[lx.pos] == '\n') {
      lx.line = lx.line + 1;
      lx.col = 1;
    } else {
      lx.col = lx.col + 1;
    }
    lx.pos = lx.pos + 1;
  }
}

u8 = is_keyword(#u8 text, uword len) {
  if (text_is(text, len, "struct")) { return TRUE; }
  if (text_is(text, len, "extern")) { return TRUE; }
  if (text_is(text, len, "import")) { return TRUE; }
  if (text_is(text, len, "const")) { return TRUE; }
  if (text_is(text, len, "if")) { return TRUE; }
  if (text_is(text, len, "else")) { return TRUE; }
  if (text_is(text, len, "while")) { return TRUE; }
  if (text_is(text, len, "break")) { return TRUE; }
  if (text_is(text, len, "continue")) { return TRUE; }
  if (text_is(text, len, "return")) { return TRUE; }
  if (text_is(text, len, "sizeof")) { return TRUE; }
  if (text_is(text, len, "as")) { return TRUE; }
  if (text_is(text, len, "void")) { return TRUE; }
  return FALSE;
}

// Skips spaces and comments. Returns FALSE when a block comment never ends.
u8 = skip_blank(~Lexer lx) {
  while (TRUE) {
    u8 c = peek(lx, 0);
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      advance(lx);
    } else if (c == '/' && peek(lx, 1) == '/') {
      while (lx.pos < lx.len && peek(lx, 0) != '\n') {
        advance(lx);
      }
    } else if (c == '/' && peek(lx, 1) == '*') {
      advance(lx);
      advance(lx);
      while (TRUE) {
        if (lx.pos >= lx.len) {
          return FALSE;
        }
        if (peek(lx, 0) == '*' && peek(lx, 1) == '/') {
          advance(lx);
          advance(lx);
          break;
        }
        advance(lx);
      }
    } else {
      return TRUE;
    }
  }
  return TRUE;
}

// The length of the punctuation token starting with c, followed by d and
// then e, or 0 when c starts none.
uword = punct_len(u8 c, u8 d, u8 e) {
  if (c == ':' && d == '=') { return 2; }
  // "#=" and "~=" are the borrow operators, except in front of another "="
  if ((c == '#' || c == '~') && d == '=' && e != '=') { return 2; }
  if (c == '=' && d == '=') { return 2; }
  if (c == '!' && d == '=') { return 2; }
  if (c == '<' && (d == '=' || d == '<')) { return 2; }
  if (c == '>' && (d == '=' || d == '>' || d == '<')) { return 2; }
  if (c == '&' && d == '&') { return 2; }
  if (c == '|' && d == '|') { return 2; }
  if (c == '(' || c == ')' || c == '{' || c == '}' || c == '[' || c == ']') { return 1; }
  if (c == ',' || c == ';' || c == '.' || c == ':' || c == '#' || c == '~') { return 1; }
  if (c == '=' || c == '!' || c == '<' || c == '>' || c == '&' || c == '|') { return 1; }
  if (c == '+' || c == '-' || c == '*' || c == '/' || c == '%') { return 1; }
  return 0;
}

// Reads one character of a literal at the lexer's position, handling the
// escapes stage 0 accepts. Returns 256 for an unknown escape.
u64 = lex_char(~Lexer lx) {
  u8 c = peek(lx, 0);
  advance(lx);
  if (c != '\\') {
    return c as u64;
  }
  c = peek(lx, 0);
  advance(lx);
  if (c == 'n') { return 10; }
  if (c == 't') { return 9; }
  if (c == 'r') { return 13; }
  if (c == '0') { return 0; }
  if (c == '\\') { return 92; }
  if (c == '\'') { return 39; }
  if (c == '"') { return 34; }
  return 256;
}

// Reads the next token into t.
void = lex_next(~Lexer lx, ~Token t) {
  t.value = 0;
  t.len = 0;
  if (!skip_blank(lx)) {
    t.kind = TK_ERROR;
    t.start = lx.pos;
    t.line = lx.line;
    t.col = lx.col;
    return;
  }
  t.start = lx.pos;
  t.line = lx.line;
  t.col = lx.col;
  if (lx.pos >= lx.len) {
    t.kind = TK_EOF;
    return;
  }
  u8 c = peek(lx, 0);

  if (is_ident_start(c)) {
    while (is_ident_char(peek(lx, 0))) {
      advance(lx);
    }
    t.len = lx.pos - t.start;
    if (is_keyword(#lx.src[t.start], t.len)) {
      t.kind = TK_KEYWORD;
    } else {
      t.kind = TK_IDENT;
    }
    return;
  }

  if (is_digit(c)) {
    u64 v = 0;
    while (is_digit(peek(lx, 0))) {
      v = v * 10 + ((peek(lx, 0) - '0') as u64);
      advance(lx);
    }
    t.len = lx.pos - t.start;
    t.value = v;
    if (is_ident_start(peek(lx, 0))) {
      t.kind = TK_ERROR;
    } else {
      t.kind = TK_INT;
    }
    return;
  }

  if (c == '"' || c == '\'') {
    u64 count = 0;
    u8 ok = TRUE;
    advance(lx);
    while (TRUE) {
      u8 d = peek(lx, 0);
      if (lx.pos >= lx.len || d == '\n') {
        ok = FALSE;
        break;
      }
      if (d == c) {
        advance(lx);
        break;
      }
      u64 ch = lex_char(lx);
      if (ch == 256) {
        ok = FALSE;
      }
      t.value = ch;
      count = count + 1;
    }
    t.len = lx.pos - t.start;
    if (!ok) {
      t.kind = TK_ERROR;
    } else if (c == '"') {
      t.kind = TK_STRING;
      t.value = count;
    } else if (count == 1) {
      t.kind = TK_CHAR;
    } else {
      // a library name, as in import('c'): text, not a character
      t.kind = TK_STRING;
      t.value = count;
    }
    return;
  }

  uword n = punct_len(c, peek(lx, 1), peek(lx, 2));
  if (n == 0) {
    advance(lx);
    t.len = 1;
    t.kind = TK_ERROR;
    return;
  }
  while (n != 0) {
    advance(lx);
    n = n - 1;
  }
  t.len = lx.pos - t.start;
  t.kind = TK_PUNCT;
}
