// cesium1: what checking expressions and statements shares, values and
// fragments of MIR text; the checking is in place.csm, expr.csm and
// stmt.csm. Written in S0.
//
// The rules and the mapping are stage 0's (bootstrap/stage0/s0_lower.c and
// the files beside it), file for file and function for function: lower.csm,
// place.csm, expr.csm, stmt.csm and decl.csm are s0_lower.c, s0_place.c,
// s0_expr.c, s0_stmt.c and s0_decl.c. Stage 0 builds MIR in memory and
// prints it; here an expression's MIR is text from the start: a fragment of
// g_frag, which the enclosing expression copies into its own text. g_frag
// is emptied before each statement, whose text then goes to g_out_funcs.
// String literals become globals as they are met, in g_out_globals, so
// that they are numbered in stage 0's order.
//
// The first error ends the program, so a checking function either returns
// a good result or does not return.

// A checked expression, or a place (somewhere a value is stored).
struct Val {
  uword start;    // the MIR text, in g_frag: a value, or a place's address
  uword len;
  uword ty;       // the value's type, or the type stored at the place
  uword local;    // a place that is a whole local: its name; otherwise 0
}

// How an expression is used.
struct Want {
  uword ty;         // the exact type wanted, or 0
  uword ptr_depth;  // ty == 0: > 0 wants any pointer of this depth (a cast's operand)
  u8 or_uword;      // with ptr_depth: a uword is accepted too (integer -> pointer cast)
  u8 allow_void;    // a call used as a statement
}

Buf g_frag;
Buf g_out_globals;
Buf g_out_funcs;
// the fragments of the arguments of the calls being lowered
~uword g_fstack;
uword g_nfstack;
// the names of the locals in scope, innermost last
~uword g_lstack;
uword g_nlstack;
uword g_fn;        // the function being lowered, in g_funcs
uword g_loops;
uword g_nstrings;
u8 g_uses_alloc;

void = low_init(uword nnodes) {
  g_fstack := alloc(nnodes * 2 + 2);
  g_lstack := alloc(nnodes + 2);
}

void = err_node(uword n, #u8 code, #u8 msg) {
  err_at(n, code);
  err_s(msg);
  err_end();
}

// ---- fragments ------------------------------------------------------------

void = frag_s(#u8 s) {
  buf_puts(~g_frag, s);
}

void = frag_copy(~Val v) {
  buf_copy(~g_frag, v.start, v.len);
}

void = frag_name(uword id) {
  name_put(~g_frag, id);
}

void = frag_ty(uword t) {
  ty_print(~g_frag, t);
}

// The fragment from start to the end of g_frag becomes v's text.
void = val_end(~Val v, uword start, uword ty) {
  v.start = start;
  v.len = g_frag.len - start;
  v.ty = ty;
  v.local = 0;
}

// v's text becomes head v ")": load(v), lnot(v).
void = val_wrap(~Val v, #u8 head) {
  uword start = g_frag.len;
  frag_s(head);
  frag_copy(v);
  frag_s(")");
  v.start = start;
  v.len = g_frag.len - start;
}

// An integer constant: "v:type".
void = val_const(~Val v, u64 value, uword ty) {
  uword start = g_frag.len;
  buf_put_u64(~g_frag, value);
  frag_s(":");
  frag_ty(ty);
  val_end(v, start, ty);
}

void = want_value(~Want w) {
  w.ty = 0;
  w.ptr_depth = 0;
  w.or_uword = FALSE;
  w.allow_void = FALSE;
}

void = want_type(~Want w, uword ty) {
  want_value(w);
  w.ty = ty;
}
