// cesium1: checking expressions and statements, and their core MIR text.
// Written in S0.
//
// The rules and the mapping are stage 0's (bootstrap/stage0/s0_lower.c),
// function for function. Stage 0 builds MIR in memory and prints it; here
// an expression's MIR is text from the start: a fragment of g_frag, which
// the enclosing expression copies into its own text. g_frag is emptied
// before each statement, whose text then goes to g_out_funcs. String
// literals become globals as they are met, in g_out_globals, so that they
// are numbered in stage 0's order.
//
// The first error ends the program, so a checking function either returns
// a good result or does not return.

// A checked expression, or a place (somewhere a value is stored).
struct Val {
  uword start;    // the MIR text, in g_frag: a value, or a place's address
  uword len;
  uword ty;       // the value's type, or the type stored at the place
  uword local;    // a place that is a whole local: its name; otherwise 0
}

// How an expression is used.
struct Want {
  uword ty;         // the exact type wanted, or 0
  uword ptr_depth;  // ty == 0: > 0 wants any pointer of this depth (a cast's operand)
  u8 or_uword;      // with ptr_depth: a uword is accepted too (integer -> pointer cast)
  u8 allow_void;    // a call used as a statement
}

Buf g_frag;
Buf g_out_globals;
Buf g_out_funcs;
// the fragments of the arguments of the calls being lowered
~uword g_fstack;
uword g_nfstack;
// the names of the locals in scope, innermost last
~uword g_lstack;
uword g_nlstack;
uword g_fn;        // the function being lowered, in g_funcs
uword g_loops;
uword g_nstrings;
u8 g_uses_alloc;

void = low_init(uword nnodes) {
  g_fstack := alloc(nnodes * 2 + 2);
  g_lstack := alloc(nnodes + 2);
}

void = err_node(uword n, #u8 code, #u8 msg) {
  err_at(n, code);
  err_s(msg);
  err_end();
}

// ---- fragments ------------------------------------------------------------

void = frag_s(#u8 s) {
  buf_puts(~g_frag, s);
}

void = frag_copy(~Val v) {
  buf_copy(~g_frag, v.start, v.len);
}

void = frag_name(uword id) {
  name_put(~g_frag, id);
}

void = frag_ty(uword t) {
  ty_print(~g_frag, t);
}

// The fragment from start to the end of g_frag becomes v's text.
void = val_end(~Val v, uword start, uword ty) {
  v.start = start;
  v.len = g_frag.len - start;
  v.ty = ty;
  v.local = 0;
}

// v's text becomes head v ")": load(v), lnot(v).
void = val_wrap(~Val v, #u8 head) {
  uword start = g_frag.len;
  frag_s(head);
  frag_copy(v);
  frag_s(")");
  v.start = start;
  v.len = g_frag.len - start;
}

// An integer constant: "v:type".
void = val_const(~Val v, u64 value, uword ty) {
  uword start = g_frag.len;
  buf_put_u64(~g_frag, value);
  frag_s(":");
  frag_ty(ty);
  val_end(v, start, ty);
}

void = want_value(~Want w) {
  w.ty = 0;
  w.ptr_depth = 0;
  w.or_uword = FALSE;
  w.allow_void = FALSE;
}

void = want_type(~Want w, uword ty) {
  want_value(w);
  w.ty = ty;
}

// ---- expressions ----------------------------------------------------------

u8 = low_is_untyped(uword e) {
  uword k = g_nodes[e].kind;
  if (k == EX_INT) {
    return TRUE;
  }
  if (k == EX_BINARY) {
    uword op = g_nodes[e].op;
    if (op == TK_PLUS || op == TK_MINUS || op == TK_STAR || op == TK_SLASH || op == TK_PERCENT || op == TK_AMP ||
        op == TK_PIPE || op == TK_XOR || op == TK_SHL || op == TK_SHR) {
      return low_is_untyped(g_nodes[e].a) && low_is_untyped(g_nodes[e].b);
    }
  }
  return FALSE;
}

u8 = low_is_place(uword e) {
  uword k = g_nodes[e].kind;
  return k == EX_NAME || k == EX_INDEX || k == EX_FIELD;
}

// Reads through pointers until the value has the depth the context wants,
// then checks the result against the context.
void = low_settle(uword at, ~Val v, ~Want w) {
  uword target = w.ptr_depth;
  if (w.ty != 0) {
    target = ty_depth(w.ty);
  }
  while (ty_depth(v.ty) > target) {
    uword t = ty_elem(v.ty);
    if (!ty_is_scalar(t)) {
      err_at(at, "E0401");
      err_s("a ");
      err_ty(t);
      err_s(" is not a value; use one of its ");
      err_parts(t);
      err_end();
    }
    val_wrap(v, "load(");
    v.ty = t;
  }
  if (w.ty != 0) {
    if (v.ty != w.ty) {
      u8 both_int = ty_is_int(v.ty) && ty_is_int(w.ty);
      if (both_int) {
        err_at(at, "E0403");
      } else {
        err_at(at, "E0402");
      }
      err_s("expected ");
      err_ty(w.ty);
      err_s(", found ");
      err_ty(v.ty);
      if (both_int) {
        err_s("; convert it with 'as'");
      }
      err_end();
    }
  } else if (w.ptr_depth > 0) {
    if (!(ty_kind(v.ty) == MT_PTR || (w.or_uword && ty_kind(v.ty) == MT_UWORD))) {
      err_at(at, "E0404");
      err_s("expected a pointer");
      if (w.or_uword) {
        err_s(" or a uword");
      }
      err_s(", found ");
      err_ty(v.ty);
      err_end();
    }
  } else if (!ty_is_int(v.ty)) {
    err_at(at, "E0405");
    err_s("expected a number, found ");
    err_ty(v.ty);
    err_end();
  }
}

// The value stored at a place: the local itself, or a load.
void = low_place_value(~Val p) {
  if (p.local != 0) {
    uword start = g_frag.len;
    frag_s("%");
    frag_name(p.local);
    p.start = start;
    p.len = g_frag.len - start;
    p.local = 0;
  } else {
    val_wrap(p, "load(");
  }
}

void = low_place_name(uword e, ~Val p) {
  uword id = g_nodes[e].id;
  uword start = g_frag.len;
  if (g_name_tab[id].local_on) {
    frag_s("addr(%");
    frag_name(id);
    frag_s(")");
    val_end(p, start, g_name_tab[id].local_ty);
    p.local = id;
    return;
  }
  uword sym = g_name_tab[id].sym;
  if (sym == SYM_GLOBAL) {
    frag_s("@");
    frag_name(id);
    val_end(p, start, g_name_tab[id].sym_ty);
    return;
  }
  if (sym == SYM_CONST) {
    err_at(e, "E0501");
    err_s("'");
    err_name(id);
    err_s("' is a constant: it has no address and cannot be assigned");
  } else if (sym == SYM_FUNC) {
    err_at(e, "E0303");
    err_s("'");
    err_name(id);
    err_s("' is a function");
  } else {
    habit_name(id, g_nodes[e].line, g_nodes[e].col);
    err_at(e, "E0304");
    err_s("unknown name '");
    err_name(id);
    err_s("'");
  }
  err_end();
}

void = low_place_index(uword e, ~Val p) {
  Val base;
  Val idx;
  Want iw;
  uword elem = 0;
  low_place(g_nodes[e].a, ~base);
  if (ty_kind(base.ty) == MT_PTR) {
    // p[i]: element i of what p points at
    elem = ty_elem(base.ty);
    low_place_value(~base);
  } else if (ty_kind(base.ty) == MT_ARRAY) {
    // an array is indexed in place
    elem = ty_elem(base.ty);
    uword start = g_frag.len;
    frag_s("as(");
    frag_ty(ty_ptr(elem));
    frag_s(", ");
    frag_copy(~base);
    frag_s(")");
    val_end(~base, start, elem);
  } else {
    err_at(e, "E0502");
    err_s("a ");
    err_ty(base.ty);
    err_s(" cannot be indexed");
    err_end();
  }
  if (ty_kind(elem) == MT_VOID) {
    err_node(e, "E0503", "a pointer to void cannot be indexed");
  }
  if (low_is_untyped(g_nodes[e].b)) {
    want_type(~iw, ty_prim(MT_UWORD));
  } else {
    want_value(~iw);
  }
  low_expr(g_nodes[e].b, ~iw, ~idx);
  uword at = g_frag.len;
  frag_s("index(");
  frag_copy(~base);
  frag_s(", ");
  frag_copy(~idx);
  frag_s(")");
  val_end(p, at, elem);
}

void = low_place_field(uword e, ~Val p) {
  Val base;
  low_place(g_nodes[e].a, ~base);
  // a.b reaches through pointers to the struct
  while (ty_kind(base.ty) == MT_PTR) {
    low_place_value(~base);
    base.ty = ty_elem(base.ty);
  }
  if (ty_kind(base.ty) != MT_STRUCT) {
    err_at(e, "E0504");
    err_s("a ");
    err_ty(base.ty);
    err_s(" has no fields");
    err_end();
  }
  uword sidx = g_types[base.ty].sidx;
  uword id = g_nodes[e].id;
  uword i = 0;
  while (i < g_structs[sidx].nfields) {
    uword f = g_structs[sidx].first + i;
    if (g_field_id[f] == id) {
      uword start = g_frag.len;
      frag_s("field(");
      frag_copy(~base);
      frag_s(", ");
      frag_name(id);
      frag_s(")");
      val_end(p, start, g_field_ty[f]);
      return;
    }
    i = i + 1;
  }
  err_at(e, "E0505");
  err_s("struct ");
  err_name(g_structs[sidx].id);
  err_s(" has no field '");
  err_name(id);
  err_s("'");
  err_end();
}

void = low_place(uword e, ~Val p) {
  uword k = g_nodes[e].kind;
  if (k == EX_NAME) {
    low_place_name(e, p);
  } else if (k == EX_INDEX) {
    low_place_index(e, p);
  } else if (k == EX_FIELD) {
    low_place_field(e, p);
  } else {
    err_node(e, "E0506", "this expression is not a variable, an element or a field");
  }
}

void = frag_op(uword op) {
  if (op == TK_PLUS) { frag_s("add"); }
  if (op == TK_MINUS) { frag_s("sub"); }
  if (op == TK_STAR) { frag_s("mul"); }
  if (op == TK_SLASH) { frag_s("div"); }
  if (op == TK_PERCENT) { frag_s("rem"); }
  if (op == TK_AMP) { frag_s("and"); }
  if (op == TK_PIPE) { frag_s("or"); }
  if (op == TK_XOR) { frag_s("xor"); }
  if (op == TK_SHL) { frag_s("shl"); }
  if (op == TK_SHR) { frag_s("shr"); }
  if (op == TK_EQ) { frag_s("eq"); }
  if (op == TK_NE) { frag_s("ne"); }
  if (op == TK_LT) { frag_s("lt"); }
  if (op == TK_LE) { frag_s("le"); }
  if (op == TK_GT) { frag_s("gt"); }
  if (op == TK_GE) { frag_s("ge"); }
  if (op == TK_ANDAND) { frag_s("land"); }
  if (op == TK_OROR) { frag_s("lor"); }
}

u8 = low_is_comparison(uword op) {
  return op == TK_EQ || op == TK_NE || op == TK_LT || op == TK_LE || op == TK_GT || op == TK_GE;
}

// The two operands of an arithmetic or comparison operator: both numbers of
// one type. A literal takes the other operand's type. fallback is the type
// for two literals, or 0 when the context gives none.
void = low_operands(uword e, uword fallback, ~Val a, ~Val b) {
  uword an = g_nodes[e].a;
  uword bn = g_nodes[e].b;
  u8 lu = low_is_untyped(an);
  u8 ru = low_is_untyped(bn);
  Want w;
  if (lu && ru) {
    if (fallback == 0 || !ty_is_int(fallback)) {
      err_node(e, "E0406", "the type of these literals is not determined by their context; write 'as T' after one");
    }
    want_type(~w, fallback);
    low_expr(an, ~w, a);
    low_expr(bn, ~w, b);
  } else if (lu) {
    // the literal on the left takes the right operand's type; the MIR
    // still evaluates left to right
    want_value(~w);
    low_expr(bn, ~w, b);
    want_type(~w, b.ty);
    low_expr(an, ~w, a);
  } else if (ru) {
    want_value(~w);
    low_expr(an, ~w, a);
    want_type(~w, a.ty);
    low_expr(bn, ~w, b);
  } else {
    want_value(~w);
    low_expr(an, ~w, a);
    low_expr(bn, ~w, b);
    if (a.ty != b.ty) {
      err_at(e, "E0407");
      err_s("the operands are ");
      err_ty(a.ty);
      err_s(" and ");
      err_ty(b.ty);
      err_s("; convert one with 'as'");
      err_end();
    }
  }
}

// Writes len bytes of g_strs from start, and a NUL, as a MIR string.
void = low_put_bytes(~Buf out, uword start, uword len) {
  buf_putc(out, '"');
  uword i = 0;
  while (i <= len) {
    u8 c = 0;
    if (i < len) {
      c = g_strs.data[start + i];
    }
    if (c == '"' || c == '\\') {
      buf_putc(out, '\\');
      buf_putc(out, c);
    } else if (c >= 32 && c < 127) {
      buf_putc(out, c);
    } else {
      buf_putc(out, '\\');
      buf_putc(out, low_hex_digit(c >> 4));
      buf_putc(out, low_hex_digit(c & 15));
    }
    i = i + 1;
  }
  buf_putc(out, '"');
}

u8 = low_hex_digit(u8 d) {
  if (d < 10) {
    return '0' + d;
  }
  return 'A' + d - 10;
}

// A string literal: a global array of its bytes and a NUL, and the value
// as(ptr<u8>, @str.N).
void = low_string(uword e, ~Val v) {
  uword n = g_nstrings;
  uword len = g_nodes[e].slen;
  uword u8t = ty_prim(MT_U8);
  g_nstrings = g_nstrings + 1;
  buf_puts(~g_out_globals, "const @str.");
  buf_put_u64(~g_out_globals, n as u64);
  buf_puts(~g_out_globals, ": ");
  ty_print(~g_out_globals, ty_array(u8t, (len + 1) as u64));
  buf_puts(~g_out_globals, " = ");
  low_put_bytes(~g_out_globals, g_nodes[e].sstart, len);
  buf_putc(~g_out_globals, '\n');
  uword start = g_frag.len;
  frag_s("as(");
  frag_ty(ty_ptr(u8t));
  frag_s(", @str.");
  buf_put_u64(~g_frag, n as u64);
  frag_s(")");
  val_end(v, start, ty_ptr(u8t));
}

void = low_call(uword e, ~Want w, ~Val v) {
  uword id = g_nodes[e].id;
  if (id == ID_ALLOC) {
    err_node(e, "E0507", "alloc(count) can only initialize or be assigned to a pointer with ':='");
  }
  if (g_name_tab[id].sym != SYM_FUNC) {
    err_at(e, "E0305");
    err_s("unknown function '");
    err_name(id);
    err_s("'");
    err_end();
  }
  uword f = g_name_tab[id].sym_idx;
  if (g_nodes[e].count != g_funcs[f].nparams) {
    err_at(e, "E0601");
    err_s("'");
    err_name(id);
    err_s("' takes ");
    err_u64(g_funcs[f].nparams as u64);
    err_s(" arguments, not ");
    err_u64(g_nodes[e].count as u64);
    err_end();
  }
  uword base = g_nfstack;
  uword arg = g_nodes[e].items;
  uword i = 0;
  while (arg != 0) {
    Want aw;
    Val av;
    want_type(~aw, g_param_ty[g_funcs[f].first + i]);
    low_expr(arg, ~aw, ~av);
    g_fstack[g_nfstack] = av.start;
    g_fstack[g_nfstack + 1] = av.len;
    g_nfstack = g_nfstack + 2;
    arg = g_nodes[arg].next;
    i = i + 1;
  }
  uword start = g_frag.len;
  frag_s("call @");
  frag_name(id);
  frag_s("(");
  uword j = base;
  while (j < g_nfstack) {
    if (j != base) {
      frag_s(", ");
    }
    buf_copy(~g_frag, g_fstack[j], g_fstack[j + 1]);
    j = j + 2;
  }
  frag_s(")");
  g_nfstack = base;
  uword ret = g_funcs[f].ret;
  val_end(v, start, ret);
  if (ty_kind(ret) == MT_VOID) {
    if (!w.allow_void) {
      err_at(e, "E0602");
      err_s("'");
      err_name(id);
      err_s("' returns nothing");
      err_end();
    }
    return;
  }
  if (w.allow_void) {
    // a statement: the result is dropped as it is
    return;
  }
  low_settle(e, v, w);
}

void = low_as(uword e, ~Want w, ~Val v) {
  uword to = ty_resolve(e);
  uword a = g_nodes[e].a;
  Want ow;
  want_value(~ow);
  if (ty_kind(to) == MT_PTR) {
    if (low_is_untyped(a)) {
      want_type(~ow, ty_prim(MT_UWORD));
    } else {
      ow.ptr_depth = ty_depth(to);
      ow.or_uword = TRUE;
    }
    low_expr(a, ~ow, v);
  } else if (ty_is_int(to)) {
    if (low_is_untyped(a)) {
      // a literal simply takes the type
      want_type(~ow, to);
      low_expr(a, ~ow, v);
      low_settle(e, v, w);
      return;
    }
    if (g_nodes[a].kind == EX_ADDROF || g_nodes[a].kind == EX_STRING) {
      // an explicit address converts to uword only
      if (ty_kind(to) != MT_UWORD) {
        err_at(e, "E0408");
        err_s("an address converts to uword only, not to ");
        err_ty(to);
        err_end();
      }
      ow.ptr_depth = 1;
    }
    low_expr(a, ~ow, v);
  } else {
    err_at(e, "E0409");
    err_s("'as' converts to a number or a pointer type, not to ");
    err_ty(to);
    err_end();
  }
  if (v.ty != to) {
    uword start = g_frag.len;
    frag_s("as(");
    frag_ty(to);
    frag_s(", ");
    frag_copy(v);
    frag_s(")");
    val_end(v, start, to);
  }
  low_settle(e, v, w);
}

void = low_int(uword e, ~Want w, ~Val v) {
  if (w.ty == 0 || !ty_is_int(w.ty)) {
    if (w.ty != 0) {
      err_at(e, "E0410");
      err_s("expected ");
      err_ty(w.ty);
      err_s(", found a number");
    } else {
      err_at(e, "E0411");
      err_s("the type of this literal is not determined by its context; write 'as T' after it");
    }
    err_end();
  }
  if (!ty_fits(w.ty, g_nodes[e].ival)) {
    err_at(e, "E0412");
    err_u64(g_nodes[e].ival);
    err_s(" does not fit ");
    err_ty(w.ty);
    err_end();
  }
  val_const(v, g_nodes[e].ival, w.ty);
}

void = low_name(uword e, ~Want w, ~Val v) {
  uword id = g_nodes[e].id;
  if (!g_name_tab[id].local_on && g_name_tab[id].sym == SYM_CONST) {
    val_const(v, g_name_tab[id].sym_val, g_name_tab[id].sym_ty);
    low_settle(e, v, w);
    return;
  }
  low_place(e, v);
  if (!ty_is_scalar(v.ty)) {
    err_at(e, "E0414");
    err_s("'");
    err_name(id);
    err_s("' is a ");
    err_ty(v.ty);
    err_s(", not a value; use one of its ");
    err_parts(v.ty);
    err_end();
  }
  low_place_value(v);
  low_settle(e, v, w);
}

void = low_addrof(uword e, ~Want w, ~Val v) {
  uword a = g_nodes[e].a;
  if (!low_is_place(a)) {
    err_node(e, "E0508", "'#' and '~' take the address of a variable, an element or a field");
  }
  low_place(a, v);
  uword t = ty_ptr(v.ty);
  // an explicit address is never read through
  if (w.ty != 0) {
    if (t != w.ty) {
      err_at(e, "E0402");
      err_s("expected ");
      err_ty(w.ty);
      err_s(", found ");
      err_ty(t);
      err_end();
    }
  } else if (w.ptr_depth == 0) {
    err_node(e, "E0415", "an address is not a number; a pointer is expected only where one is declared");
  }
  v.ty = t;
  v.local = 0;
}

void = low_binary(uword e, ~Want w, ~Val v) {
  uword op = g_nodes[e].op;
  uword ty = ty_prim(MT_U8);
  Val b;
  if (op == TK_ANDAND || op == TK_OROR) {
    Want lw;
    want_value(~lw);
    low_expr(g_nodes[e].a, ~lw, v);
    low_expr(g_nodes[e].b, ~lw, ~b);
  } else if (low_is_comparison(op)) {
    low_operands(e, 0, v, ~b);
  } else {
    low_operands(e, w.ty, v, ~b);
    ty = v.ty;
  }
  uword start = g_frag.len;
  frag_op(op);
  frag_s("(");
  frag_copy(v);
  frag_s(", ");
  frag_copy(~b);
  frag_s(")");
  val_end(v, start, ty);
  low_settle(e, v, w);
}

// Checks expression e as w wants it and gives its MIR text and type in v.
void = low_expr(uword e, ~Want w, ~Val v) {
  uword k = g_nodes[e].kind;
  if (k == EX_INT) {
    low_int(e, w, v);
  } else if (k == EX_STRING) {
    low_string(e, v);
    if (w.ty == 0 && w.ptr_depth == 0) {
      err_node(e, "E0413", "a string is a #u8, not a number");
    }
    low_settle(e, v, w);
  } else if (k == EX_NAME) {
    low_name(e, w, v);
  } else if (k == EX_INDEX || k == EX_FIELD) {
    low_place(e, v);
    if (!ty_is_scalar(v.ty)) {
      err_at(e, "E0401");
      err_s("a ");
      err_ty(v.ty);
      err_s(" is not a value; use one of its ");
      err_parts(v.ty);
      err_end();
    }
    low_place_value(v);
    low_settle(e, v, w);
  } else if (k == EX_CALL) {
    low_call(e, w, v);
  } else if (k == EX_ADDROF) {
    low_addrof(e, w, v);
  } else if (k == EX_NOT) {
    Want nw;
    want_value(~nw);
    low_expr(g_nodes[e].a, ~nw, v);
    val_wrap(v, "lnot(");
    v.ty = ty_prim(MT_U8);
    low_settle(e, v, w);
  } else if (k == EX_BINARY) {
    low_binary(e, w, v);
  } else if (k == EX_AS) {
    low_as(e, w, v);
  } else {
    // EX_SIZEOF
    uword t = ty_resolve(e);
    uword start = g_frag.len;
    frag_s("sizeof(");
    frag_ty(t);
    frag_s(")");
    val_end(v, start, ty_prim(MT_UWORD));
    low_settle(e, v, w);
  }
}

// alloc(count) for a pointer of type `to` (cesiumlang/cesium#9, mapping):
//   as(ptr<T>, call @cs_arena_alloc(mul(n, sizeof(T)), alignof(T)))
void = low_alloc(uword e, uword to, ~Val v) {
  if (g_nodes[e].count != 1) {
    err_node(e, "E0509", "alloc takes one argument, the element count");
  }
  uword elem = ty_elem(to);
  if (ty_kind(elem) == MT_VOID) {
    err_node(e, "E0510", "alloc needs an element type; the pointer is #void");
  }
  Want nw;
  Val n;
  want_type(~nw, ty_prim(MT_UWORD));
  low_expr(g_nodes[e].items, ~nw, ~n);
  g_uses_alloc = TRUE;
  uword start = g_frag.len;
  frag_s("as(");
  frag_ty(to);
  frag_s(", call @cs_arena_alloc(mul(");
  frag_copy(~n);
  frag_s(", sizeof(");
  frag_ty(elem);
  frag_s(")), alignof(");
  frag_ty(elem);
  frag_s(")))");
  val_end(v, start, to);
}

// The right side of `:=`, `#=` or `~=` for a pointer of type `to`.
void = low_pointer_value(uword e, uword op, uword to, ~Val v) {
  if (g_nodes[e].kind == EX_CALL && g_nodes[e].id == ID_ALLOC) {
    if (op != TK_OWN) {
      err_node(e, "E0511", "alloc returns ownership; receive it with ':='");
    }
    low_alloc(e, to, v);
    return;
  }
  Want pw;
  want_type(~pw, to);
  low_expr(e, ~pw, v);
}

// ---- statements -----------------------------------------------------------

void = out_s(#u8 s) {
  buf_puts(~g_out_funcs, s);
}

void = out_val(~Val v) {
  buf_putn(~g_out_funcs, #g_frag.data[v.start], v.len);
}

void = out_name(uword id) {
  name_put(~g_out_funcs, id);
}

void = out_ty(uword t) {
  ty_print(~g_out_funcs, t);
}

void = out_indent(uword depth) {
  uword i = 0;
  while (i < depth) {
    out_s("  ");
    i = i + 1;
  }
}

// Reports a new name that collides with one in use. Whether Cesium allows
// shadowing is not recorded, so S0 allows none.
void = low_name_free(uword id, uword at, u8 check_locals) {
  uword sym = g_name_tab[id].sym;
  if (id != ID_ALLOC && sym == SYM_NONE && !(check_locals && g_name_tab[id].local_on)) {
    return;
  }
  err_at(at, "E0302");
  err_s("'");
  err_name(id);
  err_s("' is already the name of ");
  if (id == ID_ALLOC) {
    err_s("the built-in alloc");
  } else if (sym == SYM_CONST) {
    err_s("a constant");
  } else if (sym == SYM_GLOBAL) {
    err_s("a global");
  } else if (sym == SYM_FUNC) {
    err_s("a function");
  } else if (sym == SYM_STRUCT) {
    err_s("a struct");
  } else {
    err_s("a local or parameter");
  }
  err_end();
}

void = low_local_add(uword id, uword ty) {
  g_name_tab[id].local_on = TRUE;
  g_name_tab[id].local_ty = ty;
  g_lstack[g_nlstack] = id;
  g_nlstack = g_nlstack + 1;
}

// Ends the scope of the locals declared after the first `keep`.
void = low_locals_drop(uword keep) {
  while (g_nlstack > keep) {
    g_nlstack = g_nlstack - 1;
    g_name_tab[g_lstack[g_nlstack]].local_on = FALSE;
  }
}

void = low_decl(uword s, uword depth) {
  uword t = ty_resolve(s);
  uword op = g_nodes[s].op;
  Val init;
  if (g_nodes[s].is_array) {
    if (g_nodes[s].ival == 0) {
      err_node(s, "E0306", "an array has at least one element");
    }
    t = ty_array(t, g_nodes[s].ival);
  }
  if (op != TK_EOF) {
    if (!ty_is_scalar(t)) {
      err_at(s, "E0512");
      err_s("a ");
      err_ty(t);
      err_s(" has no initializer in S0; assign its ");
      err_parts(t);
      err_s(" one at a time");
      err_end();
    }
    if (ty_kind(t) == MT_PTR) {
      if (op == TK_ASSIGN) {
        err_node(s, "E0513", "a pointer is initialized with ':=', '#=' or '~='; plain '=' assigns through it");
      }
      low_pointer_value(g_nodes[s].b, op, t, ~init);
    } else {
      if (op != TK_ASSIGN) {
        err_at(s, "E0514");
        err_tok(op);
        err_s(" is only for pointers; a plain value is initialized with '='");
        err_end();
      }
      Want iw;
      want_type(~iw, t);
      low_expr(g_nodes[s].b, ~iw, ~init);
    }
  }
  // the name comes into scope after its initializer
  low_name_free(g_nodes[s].id, s, TRUE);
  out_indent(depth);
  out_s("local %");
  out_name(g_nodes[s].id);
  out_s(": ");
  out_ty(t);
  if (op != TK_EOF) {
    out_s(" = ");
    out_val(~init);
  }
  out_s("\n");
  low_local_add(g_nodes[s].id, t);
}

void = low_assign(uword s, uword depth) {
  uword op = g_nodes[s].op;
  Val p;
  Val v;
  if (!low_is_place(g_nodes[s].a)) {
    err_node(s, "E0515", "the left side of an assignment is a variable, an element or a field");
  }
  low_place(g_nodes[s].a, ~p);
  if (op == TK_ASSIGN) {
    // plain '=' stores a number, through pointers if the place holds one
    while (ty_kind(p.ty) == MT_PTR) {
      uword t = ty_elem(p.ty);
      low_place_value(~p);
      p.ty = t;
    }
    if (!ty_is_int(p.ty)) {
      err_at(s, "E0516");
      err_s("a ");
      err_ty(p.ty);
      err_s(" is not assigned as a whole in S0; assign its ");
      err_parts(p.ty);
      err_end();
    }
    Want vw;
    want_type(~vw, p.ty);
    low_expr(g_nodes[s].b, ~vw, ~v);
  } else {
    if (ty_kind(p.ty) != MT_PTR) {
      err_at(s, "E0517");
      err_tok(op);
      err_s(" sets where a pointer points; the left side is a ");
      err_ty(p.ty);
      err_end();
    }
    low_pointer_value(g_nodes[s].b, op, p.ty, ~v);
  }
  out_indent(depth);
  if (p.local != 0) {
    out_s("set %");
    out_name(p.local);
    out_s(" = ");
  } else {
    out_s("store ");
    out_val(~p);
    out_s(", ");
  }
  out_val(~v);
  out_s("\n");
}

void = low_eval(uword s, uword depth) {
  Want w;
  Val v;
  if (g_nodes[g_nodes[s].a].kind != EX_CALL) {
    err_node(s, "E0603", "only a call can be a statement");
  }
  want_value(~w);
  w.allow_void = TRUE;
  low_call(g_nodes[s].a, ~w, ~v);
  out_indent(depth);
  out_s("eval ");
  out_val(~v);
  out_s("\n");
}

// if and while: the condition, then the block.
void = low_cond(uword s, uword depth, #u8 keyword) {
  Want w;
  Val c;
  want_value(~w);
  low_expr(g_nodes[s].a, ~w, ~c);
  out_indent(depth);
  out_s(keyword);
  out_val(~c);
  out_s(" {\n");
}

void = low_return(uword s, uword depth) {
  uword ret = g_funcs[g_fn].ret;
  uword fid = g_funcs[g_fn].id;
  if (g_nodes[s].a == 0) {
    if (ty_kind(ret) != MT_VOID) {
      err_at(s, "E0605");
      err_s("'");
      err_name(fid);
      err_s("' returns a ");
      err_ty(ret);
      err_end();
    }
    out_indent(depth);
    out_s("return\n");
    return;
  }
  if (ty_kind(ret) == MT_VOID) {
    err_at(s, "E0602");
    err_s("'");
    err_name(fid);
    err_s("' returns nothing");
    err_end();
  }
  Want w;
  Val v;
  want_type(~w, ret);
  low_expr(g_nodes[s].a, ~w, ~v);
  out_indent(depth);
  out_s("return ");
  out_val(~v);
  out_s("\n");
}

void = low_stmt(uword s, uword depth) {
  uword k = g_nodes[s].kind;
  g_frag.len = 0;
  if (k == ST_DECL) {
    low_decl(s, depth);
  } else if (k == ST_ASSIGN) {
    low_assign(s, depth);
  } else if (k == ST_EXPR) {
    low_eval(s, depth);
  } else if (k == ST_IF) {
    low_cond(s, depth, "if ");
    low_block(g_nodes[s].body, depth + 1);
    out_indent(depth);
    out_s("}");
    // `else if` parses as an else block holding one if statement
    if (g_nodes[s].els != 0) {
      out_s(" else {\n");
      low_block(g_nodes[s].els, depth + 1);
      out_indent(depth);
      out_s("}");
    }
    out_s("\n");
  } else if (k == ST_WHILE) {
    low_cond(s, depth, "while ");
    g_loops = g_loops + 1;
    low_block(g_nodes[s].body, depth + 1);
    g_loops = g_loops - 1;
    out_indent(depth);
    out_s("}\n");
  } else if (k == ST_BREAK || k == ST_CONTINUE) {
    if (g_loops == 0) {
      if (k == ST_BREAK) {
        err_node(s, "E0604", "'break' outside a loop");
      }
      err_node(s, "E0604", "'continue' outside a loop");
    }
    out_indent(depth);
    if (k == ST_BREAK) {
      out_s("break\n");
    } else {
      out_s("continue\n");
    }
  } else {
    low_return(s, depth);
  }
}

void = low_block(uword s, uword depth) {
  uword keep = g_nlstack;
  while (s != 0) {
    low_stmt(s, depth);
    s = g_nodes[s].next;
  }
  low_locals_drop(keep);
}

// True when control cannot reach the end of the block: libcsmir's
// verifier requires it of a function that returns a value. A loop is never
// counted as returning. Each statement became one MIR statement, so the
// syntax tree answers for the MIR.
u8 = low_block_returns(uword s) {
  while (s != 0) {
    uword k = g_nodes[s].kind;
    if (k == ST_RETURN) {
      return TRUE;
    }
    if (k == ST_IF && g_nodes[s].els != 0 && low_block_returns(g_nodes[s].body) &&
        low_block_returns(g_nodes[s].els)) {
      return TRUE;
    }
    s = g_nodes[s].next;
  }
  return FALSE;
}
