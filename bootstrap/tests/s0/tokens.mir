cesium-mir 0

struct Token { kind: i64, start: ptr<u8>, len: uword }

const @str.0: [6 x u8] = "hello\00"
const @str.1: [15 x u8] = "token length: \00"

extern func @putchar(i32) -> i32 callconv(c)

func @cstr_len(%s: ptr<u8>) -> uword {
  local %n: uword = 0:uword
  while ne(load(index(%s, %n)), 0:u8) {
    set %n = add(%n, 1:uword)
  }
  return %n
}

func @print(%s: ptr<u8>) -> void {
  local %i: uword = 0:uword
  while ne(load(index(%s, %i)), 0:u8) {
    eval call @putchar(as(i32, load(index(%s, %i))))
    set %i = add(%i, 1:uword)
  }
}

func @fmt_u64(%v: u64, %buf: ptr<u8>) -> uword {
  local %tmp: [20 x u8]
  local %n: uword = 0:uword
  if eq(%v, 0:u64) {
    store index(%buf, 0:uword), 48:u8
    return 1:uword
  }
  while ne(%v, 0:u64) {
    store index(as(ptr<u8>, addr(%tmp)), %n), as(u8, add(48:u64, rem(%v, 10:u64)))
    set %v = div(%v, 10:u64)
    set %n = add(%n, 1:uword)
  }
  local %i: uword = 0:uword
  while lt(%i, %n) {
    store index(%buf, %i), load(index(as(ptr<u8>, addr(%tmp)), sub(sub(%n, 1:uword), %i)))
    set %i = add(%i, 1:uword)
  }
  return %n
}

export func @main(%argc: i32, %argv: ptr<ptr<u8>>) -> i32 {
  local %t: ptr<Token> = as(ptr<Token>, call @cs_arena_alloc(mul(1:uword, sizeof(Token)), alignof(Token)))
  store field(%t, kind), 1:i64
  store field(%t, start), as(ptr<u8>, @str.0)
  store field(%t, len), call @cstr_len(load(field(%t, start)))
  local %buf: ptr<u8> = as(ptr<u8>, call @cs_arena_alloc(mul(32:uword, sizeof(u8)), alignof(u8)))
  local %n: uword = call @fmt_u64(as(u64, load(field(%t, len))), %buf)
  store index(%buf, %n), 10:u8
  store index(%buf, add(%n, 1:uword)), 0:u8
  eval call @print(as(ptr<u8>, @str.1))
  eval call @print(%buf)
  return 0:i32
}

extern func @cs_arena_alloc(uword, uword) -> ptr<u8> callconv(c)
