// Control flow: if / else if / else, while, break, continue, return, recursion.
// spec: s0.statement, s0.statement.braces, s0.statement.loops, s0.func, s0.func.single-return, s0.condition
const u8 TRUE = 1;

u64 = fib(u64 n) {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

// mutual recursion: a function is called before its definition
u8 = is_even(u64 n) {
  if (n == 0) {
    return 1;
  }
  return is_odd(n - 1);
}

u8 = is_odd(u64 n) {
  if (n == 0) {
    return 0;
  }
  return is_even(n - 1);
}

i64 = classify(i64 n) {
  if (n < 0) {
    return 0 - 1;
  } else if (n == 0) {
    return 0;
  } else if (n < 10) {
    return 1;
  } else {
    return 2;
  }
}

i32 = main(i32 argc, ##u8 argv) {
  show_u("fib(20)", fib(20));
  show("is_even(10)", is_even(10) as i64);
  show("is_odd(10)", is_odd(10) as i64);
  show("classify(-5)", classify(0 - 5));
  show("classify(0)", classify(0));
  show("classify(7)", classify(7));
  show("classify(70)", classify(70));

  // break out of an endless loop
  u64 n = 0;
  while (TRUE) {
    n = n + 1;
    if (n == 5) {
      break;
    }
  }
  show_u("stopped at", n);

  // continue skips the odd numbers
  u64 i = 0;
  u64 evens = 0;
  while (i < 10) {
    i = i + 1;
    if (i % 2 != 0) {
      continue;
    }
    evens = evens + i;
  }
  show_u("sum of evens to 10", evens);

  // nested loops: break leaves the inner loop only
  u64 row = 0;
  u64 cells = 0;
  while (row < 4) {
    u64 col = 0;
    while (TRUE) {
      if (col > row) {
        break;
      }
      cells = cells + 1;
      col = col + 1;
    }
    row = row + 1;
  }
  show_u("triangle cells", cells);

  // a name declared in one block can be declared again in the next
  if (cells == 10) {
    u8 once = 1;
    show("first block", once as i64);
  }
  if (cells == 10) {
    u8 once = 2;
    show("second block", once as i64);
  }
  return 0;
}
