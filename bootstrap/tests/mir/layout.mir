cesium-mir 0

struct Mixed { a: u8, b: u32, c: u8, d: u64, e: u16 }

struct Inner { x: u16, y: u8 }

struct Outer { tag: u8, inner: Inner, arr: [3 x Inner], next: ptr<Outer> }

const @s.0: [14 x u8] = "sizeof(Mixed)\00"
const @s.1: [15 x u8] = "alignof(Mixed)\00"
const @s.2: [8 x u8] = "Mixed.a\00"
const @s.3: [8 x u8] = "Mixed.b\00"
const @s.4: [8 x u8] = "Mixed.c\00"
const @s.5: [8 x u8] = "Mixed.d\00"
const @s.6: [8 x u8] = "Mixed.e\00"
const @s.7: [14 x u8] = "sizeof(Inner)\00"
const @s.8: [15 x u8] = "alignof(Inner)\00"
const @s.9: [14 x u8] = "sizeof(Outer)\00"
const @s.10: [15 x u8] = "alignof(Outer)\00"
const @s.11: [10 x u8] = "Outer.tag\00"
const @s.12: [12 x u8] = "Outer.inner\00"
const @s.13: [10 x u8] = "Outer.arr\00"
const @s.14: [11 x u8] = "Outer.next\00"
const @s.15: [15 x u8] = "Outer.arr[2].y\00"
const @s.16: [18 x u8] = "sizeof([5 x u32])\00"
const @s.17: [16 x u8] = "sizeof(ptr<u8>)\00"
const @s.18: [20 x u8] = "fresh local is zero\00"
const @lib.0: [3 x u8] = ": \00"
const @lib.1: [3 x u8] = ": \00"

extern func @putchar(i32) -> i32 callconv(c)

func @print(%s: ptr<u8>) -> void {
  local %i: uword = 0:uword
  while ne(load(index(%s, %i)), 0:u8) {
    eval call @putchar(as(i32, load(index(%s, %i))))
    set %i = add(%i, 1:uword)
  }
}

func @print_u64(%v: u64) -> void {
  local %digits: [20 x u8]
  local %n: uword = 0:uword
  if eq(%v, 0:u64) {
    eval call @putchar(48:i32)
    return
  }
  while ne(%v, 0:u64) {
    store index(as(ptr<u8>, addr(%digits)), %n), as(u8, add(48:u64, rem(%v, 10:u64)))
    set %v = div(%v, 10:u64)
    set %n = add(%n, 1:uword)
  }
  while ne(%n, 0:uword) {
    set %n = sub(%n, 1:uword)
    eval call @putchar(as(i32, load(index(as(ptr<u8>, addr(%digits)), %n))))
  }
}

func @print_i64(%v: i64) -> void {
  if lt(%v, 0:i64) {
    eval call @putchar(45:i32)
    eval call @print_u64(as(u64, sub(0:i64, %v)))
  } else {
    eval call @print_u64(as(u64, %v))
  }
}

func @show(%label: ptr<u8>, %v: i64) -> void {
  eval call @print(%label)
  eval call @print(as(ptr<u8>, @lib.0))
  eval call @print_i64(%v)
  eval call @putchar(10:i32)
}

func @show_u(%label: ptr<u8>, %v: u64) -> void {
  eval call @print(%label)
  eval call @print(as(ptr<u8>, @lib.1))
  eval call @print_u64(%v)
  eval call @putchar(10:i32)
}

export func @main(%argc: i32, %argv: ptr<ptr<u8>>) -> i32 {
  local %m: Mixed
  local %o: Outer
  eval call @show_u(as(ptr<u8>, @s.0), as(u64, sizeof(Mixed)))
  eval call @show_u(as(ptr<u8>, @s.1), as(u64, alignof(Mixed)))
  eval call @show_u(as(ptr<u8>, @s.2), as(u64, sub(as(uword, field(addr(%m), a)), as(uword, addr(%m)))))
  eval call @show_u(as(ptr<u8>, @s.3), as(u64, sub(as(uword, field(addr(%m), b)), as(uword, addr(%m)))))
  eval call @show_u(as(ptr<u8>, @s.4), as(u64, sub(as(uword, field(addr(%m), c)), as(uword, addr(%m)))))
  eval call @show_u(as(ptr<u8>, @s.5), as(u64, sub(as(uword, field(addr(%m), d)), as(uword, addr(%m)))))
  eval call @show_u(as(ptr<u8>, @s.6), as(u64, sub(as(uword, field(addr(%m), e)), as(uword, addr(%m)))))
  eval call @show_u(as(ptr<u8>, @s.7), as(u64, sizeof(Inner)))
  eval call @show_u(as(ptr<u8>, @s.8), as(u64, alignof(Inner)))
  eval call @show_u(as(ptr<u8>, @s.9), as(u64, sizeof(Outer)))
  eval call @show_u(as(ptr<u8>, @s.10), as(u64, alignof(Outer)))
  eval call @show_u(as(ptr<u8>, @s.11), as(u64, sub(as(uword, field(addr(%o), tag)), as(uword, addr(%o)))))
  eval call @show_u(as(ptr<u8>, @s.12), as(u64, sub(as(uword, field(addr(%o), inner)), as(uword, addr(%o)))))
  eval call @show_u(as(ptr<u8>, @s.13), as(u64, sub(as(uword, field(addr(%o), arr)), as(uword, addr(%o)))))
  eval call @show_u(as(ptr<u8>, @s.14), as(u64, sub(as(uword, field(addr(%o), next)), as(uword, addr(%o)))))
  eval call @show_u(as(ptr<u8>, @s.15), as(u64, sub(as(uword, field(index(as(ptr<Inner>, field(addr(%o), arr)), 2:uword), y)), as(uword, addr(%o)))))
  eval call @show_u(as(ptr<u8>, @s.16), as(u64, sizeof([5 x u32])))
  eval call @show_u(as(ptr<u8>, @s.17), as(u64, sizeof(ptr<u8>)))
  eval call @show_u(as(ptr<u8>, @s.18), load(field(addr(%m), d)))
  return 0:i32
}
