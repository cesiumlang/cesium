cesium-mir 0

const @s.0: [11 x u8] = "i8 127 + 1\00"
const @s.1: [14 x u8] = "u16 65535 + 1\00"
const @s.2: [15 x u8] = "neg i16 -32768\00"
const @s.3: [13 x u8] = "i8 -127 / -1\00"
const @s.4: [13 x u8] = "i8 -128 >> 1\00"
const @s.5: [12 x u8] = "u8 128 >> 1\00"
const @s.6: [10 x u8] = "not u16 0\00"
const @s.7: [13 x u8] = "i16 -1 as u8\00"
const @s.8: [17 x u8] = "u16 40000 as i16\00"
const @s.9: [13 x u8] = "i8 -1 as u64\00"
const @s.10: [14 x u8] = "u8 255 as u64\00"
const @s.11: [10 x u8] = "i8 -1 < 1\00"
const @s.12: [11 x u8] = "u8 255 < 1\00"
const @s.13: [14 x u8] = "i16 300 * 300\00"
const @s.14: [12 x u8] = "u16 1 << 17\00"
const @s.15: [13 x u8] = "i32 -7 rem 3\00"
const @s.16: [12 x u8] = "u64 max / 3\00"
const @s.17: [13 x u8] = "i64 min + -1\00"
const @s.18: [11 x u8] = "land(2, 0)\00"
const @s.19: [10 x u8] = "lor(0, 4)\00"
const @s.20: [8 x u8] = "lnot(0)\00"
const @lib.0: [3 x u8] = ": \00"
const @lib.1: [3 x u8] = ": \00"

extern func @putchar(i32) -> i32 callconv(c)

func @print(%s: ptr<u8>) -> void {
  local %i: uword = 0:uword
  while ne(load(index(%s, %i)), 0:u8) {
    eval call @putchar(as(i32, load(index(%s, %i))))
    set %i = add(%i, 1:uword)
  }
}

func @print_u64(%v: u64) -> void {
  local %digits: [20 x u8]
  local %n: uword = 0:uword
  if eq(%v, 0:u64) {
    eval call @putchar(48:i32)
    return
  }
  while ne(%v, 0:u64) {
    store index(as(ptr<u8>, addr(%digits)), %n), as(u8, add(48:u64, rem(%v, 10:u64)))
    set %v = div(%v, 10:u64)
    set %n = add(%n, 1:uword)
  }
  while ne(%n, 0:uword) {
    set %n = sub(%n, 1:uword)
    eval call @putchar(as(i32, load(index(as(ptr<u8>, addr(%digits)), %n))))
  }
}

func @print_i64(%v: i64) -> void {
  if lt(%v, 0:i64) {
    eval call @putchar(45:i32)
    eval call @print_u64(as(u64, sub(0:i64, %v)))
  } else {
    eval call @print_u64(as(u64, %v))
  }
}

func @show(%label: ptr<u8>, %v: i64) -> void {
  eval call @print(%label)
  eval call @print(as(ptr<u8>, @lib.0))
  eval call @print_i64(%v)
  eval call @putchar(10:i32)
}

func @show_u(%label: ptr<u8>, %v: u64) -> void {
  eval call @print(%label)
  eval call @print(as(ptr<u8>, @lib.1))
  eval call @print_u64(%v)
  eval call @putchar(10:i32)
}

export func @main(%argc: i32, %argv: ptr<ptr<u8>>) -> i32 {
  eval call @show(as(ptr<u8>, @s.0), as(i64, add(127:i8, 1:i8)))
  eval call @show(as(ptr<u8>, @s.1), as(i64, add(65535:u16, 1:u16)))
  eval call @show(as(ptr<u8>, @s.2), as(i64, neg(-32768:i16)))
  eval call @show(as(ptr<u8>, @s.3), as(i64, div(-127:i8, -1:i8)))
  eval call @show(as(ptr<u8>, @s.4), as(i64, shr(-128:i8, 1:i8)))
  eval call @show(as(ptr<u8>, @s.5), as(i64, shr(128:u8, 1:u8)))
  eval call @show(as(ptr<u8>, @s.6), as(i64, not(0:u16)))
  eval call @show(as(ptr<u8>, @s.7), as(i64, as(u8, -1:i16)))
  eval call @show(as(ptr<u8>, @s.8), as(i64, as(i16, 40000:u16)))
  eval call @show_u(as(ptr<u8>, @s.9), as(u64, -1:i8))
  eval call @show_u(as(ptr<u8>, @s.10), as(u64, 255:u8))
  eval call @show(as(ptr<u8>, @s.11), as(i64, lt(-1:i8, 1:i8)))
  eval call @show(as(ptr<u8>, @s.12), as(i64, lt(255:u8, 1:u8)))
  eval call @show(as(ptr<u8>, @s.13), as(i64, mul(300:i16, 300:i16)))
  eval call @show(as(ptr<u8>, @s.14), as(i64, shl(1:u16, 17:u16)))
  eval call @show(as(ptr<u8>, @s.15), as(i64, rem(-7:i32, 3:i32)))
  eval call @show_u(as(ptr<u8>, @s.16), div(18446744073709551615:u64, 3:u64))
  eval call @show(as(ptr<u8>, @s.17), add(-9223372036854775808:i64, -1:i64))
  eval call @show(as(ptr<u8>, @s.18), as(i64, land(2:u32, 0:u64)))
  eval call @show(as(ptr<u8>, @s.19), as(i64, lor(0:u8, 4:i16)))
  eval call @show(as(ptr<u8>, @s.20), as(i64, lnot(0:i64)))
  return 0:i32
}
