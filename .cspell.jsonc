{
  "version": "0.2",
  "import": [
    ".cspell/cesium/cspell-ext.json",
  ],
  "ignorePaths": [
    ".cspell.json*",
    ".cspell/**",
    ".git/**",
    "*.code-workspace",
    ".gitignore",
    ".local-gitignore",
    ".env",
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".vscode/ltex.dictionary.en-US.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "win32",
    "scientific-terms-us",
    "cesium",
    "project-words",
    "zig",
  ],
  "words": [],
  "ignoreWords": [],
  "ignoreRegExpList": [
    "/-W.*/",
    "/-D.*/",
    "/-X.*/",
    "/-i.*/",
    "/-I.*/",
    "/-f.*/",
  ],
  "allowCompoundWords": true,
}
