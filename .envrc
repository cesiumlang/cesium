#!/usr/bin/env bash
# direnv: put the Cesium devkit and the build outputs on PATH.
# The devkit is fetched with: bash tools/fetch-devkit.sh

# the tools buildtools installed in its opt/ (the Vulkan SDK, tree-sitter,
# Node.js, direnv), each where it is installed
source_env_if_exists buildtools/.envrc

PATH_add ".devkit/zig"
PATH_add ".devkit/qbe/bin"
PATH_add "zig-out/bin"
